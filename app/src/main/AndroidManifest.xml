<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeScan">
        
        <!-- 主Activity - 默认不显示，通过alias控制 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="@string/dis_name"
            android:enabled="false" />
        
        <!-- 默认绿色图标 -->
        <activity-alias
            android:name=".MainActivityAliasDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <!-- 多彩图标 -->
        <activity-alias
            android:name=".MainActivityAliasColorful"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_colorful"
            android:roundIcon="@mipmap/ic_launcher_round_colorful"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <!-- 快速扫描Activity - 默认不显示，通过alias控制 -->
        <activity
            android:name=".QuickScanActivity"
            android:exported="false"
            android:theme="@style/Theme.CodeScan"
            android:launchMode="singleTask"
            android:taskAffinity="me.huidoudour.QRCode.scan.quickscan"
            android:enabled="false" />
        
        <!-- 快速扫描 - 默认绿色图标 -->
        <activity-alias
            android:name=".QuickScanActivityAliasDefault"
            android:targetActivity=".QuickScanActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_quick"
            android:roundIcon="@mipmap/ic_launcher_round_quick"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <!-- 快速扫描 - 多彩图标 -->
        <activity-alias
            android:name=".QuickScanActivityAliasColorful"
            android:targetActivity=".QuickScanActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_quick_colorful"
            android:roundIcon="@mipmap/ic_launcher_round_quick_colorful"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        
        <activity
            android:name=".MeActivity"
            android:exported="false"
            android:theme="@style/Theme.CodeScan" />
        
        <activity
            android:name=".StartupRecordsActivity"
            android:exported="true"
            android:theme="@style/Theme.CodeScan" />
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="me.huidoudour.core"
            android:value="true" />
        <meta-data
            android:name="me.huidoudour.core.version"
            android:value="37" />

    </application>

</manifest>